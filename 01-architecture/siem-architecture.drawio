 cases" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12;arcSize=12;" vertex="1" parent="elsrv"><mxGeometry x="20" y="255" width="460" height="70" as="geometry"/></mxCell><mxCell id="ts" value="&lt;b&gt;Tailscale&lt;/b&gt; subnet router (advertises &amp;lt;LAB_SUBNET&amp;gt;)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;fontSize=12;arcSize=12;" vertex="1" parent="elsrv"><mxGeometry x="20" y="345" width="460" height="50" as="geometry"/></mxCell><mxCell id="dv" value="&lt;i&gt;Data views: SOC - Windows · SOC - FortiGate&lt;/i&gt;" style="text;html=1;fontSize=11;align=center;fontColor=#555555;" vertex="1" parent="elsrv"><mxGeometry x="20" y="410" width="460" height="30" as="geometry"/></mxCell><mxCell id="nat" value="VMware NAT network (internet access)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;fontSize=12;arcSize=12;" vertex="1" parent="host"><mxGeometry x="20" y="640" width="480" height="50" as="geometry"/></mxCell><mxCell id="inet" value="Internet" style="ellipse;shape=cloud;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1240" y="760" width="160" height="100" as="geometry"/></mxCell><mxCell id="tsnet" value="Tailscale (WireGuard)&lt;br&gt;encrypted overlay" style="ellipse;shape=cloud;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1220" y="440" width="200" height="120" as="geometry"/></mxCell><mxCell id="team" value="Team members&lt;br&gt;(Tailscale client)" style="shape=umlActor;verticalLabelPosition=bottom;verticalAlign=top;html=1;outlineConnect=0;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1300" y="250" width="40" height="70" as="geometry"/></mxCell><mxCell id="acc" value="&lt;b&gt;Access model&lt;/b&gt;&lt;br&gt;• Node sharing → SIEM VM only (Kibana)&lt;br&gt;• Tailnet user → whole lab (infra role)&lt;br&gt;• Individua