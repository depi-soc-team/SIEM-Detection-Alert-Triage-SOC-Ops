<mxfile host="app.diagrams.net" agent="DEPI SOC project" version="24.0.0"><diagram id="ref" name="1 - Reference Architecture (Medium Org)"><mxGraphModel dx="1600" dy="1000" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1654" pageHeight="1169" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="t1" value="SIEM Reference Architecture – Medium Organization (~300 users)" style="text;html=1;fontSize=22;fontStyle=1;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="20" y="10" width="1000" height="40" as="geometry"/></mxCell><mxCell id="t1s" value="Design target for the project. The lab (page 2) implements a scaled-down version of this design." style="text;html=1;fontSize=12;align=left;verticalAlign=middle;fontColor=#555555;" vertex="1" parent="1"><mxGeometry x="20" y="48" width="1000" height="24" as="geometry"/></mxCell><mxCell id="srcs" value="1. Data Sources" style="swimlane;whiteSpace=wrap;html=1;startSize=30;fontStyle=1;fontSize=14;fillColor=#dae8fc;strokeColor=#6c8ebf;swimlaneFillColor=#F5F9FF;" vertex="1" parent="1"><mxGeometry x="20" y="90" width="290" height="640" as="geometry"/></mxCell><mxCell id="s_ep" value="Endpoints&lt;br&gt;&lt;i&gt;Windows workstations + Sysmon&lt;/i&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;fontSize=12;arcSize=12;" vertex="1" parent="srcs"><mxGeometry x="20" y="45" width="250" height="66" as="geometry"/></mxCell><mxCell id="s_srv" value="Servers&lt;br&gt;&lt;i&gt;Windows / Linux&lt;/i&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;fontSize=12;arcSize=12;" vertex="1" parent="srcs"><mxGeometry x="20" y="128" width="250" height="66" as="geometry"/></mxCell><mxCell id="s_id" value="Identity&lt;br&gt;&lt;i&gt;Active Directory / Entra ID&lt;/i&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;fontSize=12;arcSize=12;" verte